[Unit]
Description=Least Count Rush Backend API Server
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/least-count-rush-backend/backend
Environment="PATH=/home/ec2-user/least-count-rush-backend/backend/venv/bin"
ExecStart=/home/ec2-user/least-count-rush-backend/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=least-count-rush

[Install]
WantedBy=multi-user.target

